# Obscura (headless browser engine) for the homelab — x86_64 Linux.
FROM debian:bookworm-slim

ARG OBSCURA_VERSION=v0.2.7
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates xz-utils \
 && curl -fsSL -o /tmp/o.tar.gz \
      "https://github.com/h4ckf0r0day/obscura/releases/download/${OBSCURA_VERSION}/obscura-x86_64-linux-stealth.tar.gz" \
 && mkdir -p /opt/obscura && tar xzf /tmp/o.tar.gz -C /opt/obscura \
 && rm /tmp/o.tar.gz && apt-get purge -y xz-utils && apt-get autoremove -y \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV OBSCURA_ALLOW_PRIVATE_NETWORK=1
EXPOSE 9222
HEALTHCHECK --interval=30s --timeout=6s --start-period=20s \
  CMD curl -fsS -H "Authorization: Bearer ${OBSCURA_CDP_TOKEN}" http://127.0.0.1:9222/json/version >/dev/null || exit 1
ENTRYPOINT ["/opt/obscura/obscura"]
