# copy to deploy/.env and fill what you have. Nothing here is required except the host.
PUBLIC_HOST=os.liflix.online
PUBLIC_ORIGIN=https://os.liflix.online

# optional free-tier provider keys (leave blank to skip that provider)
IPQS_KEY=
VERIPHONE_KEY=
NUMLOOKUPAPI_KEY=
ABSTRACTAPI_KEY=
NUMVERIFY_KEY=

# ---------------------------------------------------------------- browser side
# Obscura refuses CDP on a non-loopback bind without a token (min 32 bytes).
# Both the browser and the sidecar read this same file: deploy/compose.yml mounts
# it via env_file, so put the real value in /srv/cloud/os/obscura.env (mode 600),
# NOT here (this file is only the reference).
#
#   sudo sh -c 'openssl rand -hex 32 > /srv/cloud/os/obscura.env.tmp'
#   sudo sh -c 'echo "OBSCURA_CDP_TOKEN=$(cat /srv/cloud/os/obscura.env.tmp)" > /srv/cloud/os/obscura.env'
#   sudo chmod 600 /srv/cloud/os/obscura.env
OBSCURA_CDP_TOKEN=
