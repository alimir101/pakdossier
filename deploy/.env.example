# copy to deploy/.env and fill what you have. Nothing here is required except the host.
PUBLIC_HOST=os.liflix.online
PUBLIC_ORIGIN=https://os.liflix.online

# optional free-tier provider keys (leave blank to skip that provider)
IPQS_KEY=
VERIPHONE_KEY=
NUMLOOKUPAPI_KEY=
ABSTRACTAPI_KEY=
NUMVERIFY_KEY=
